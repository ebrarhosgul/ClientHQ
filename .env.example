# Copy this file to .env.local and fill in real values.
# .env.local is git ignored; this template is committed and must stay valueless.
#
# Only the "Scaffold" block below is read today. Everything under it is the full
# configuration spec 0001 calls for, kept here so nothing is lost, and switched on
# by the feature that needs it (see docs/scope/scope.md).

# ---------------------------------------------------------------------------
# Scaffold (feature 1) - required now
# ---------------------------------------------------------------------------

# Supabase transaction mode pooler, port 6543. The app runs every query through
# this. Drizzle must run with prepared statements disabled against PgBouncer.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres"

# Direct connection, port 5432. Migrations only, never the running app.
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# Absolute base URL. Used by Stripe redirects and email links later.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Tenant scoping data access layer (feature 4) - required now. The session
# module reads Clerk session claims, and the Clerk SDK picks these up from the
# process environment itself. Feature 6 adds the sign in flow that uses them.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."

# Agency sign in & organization (feature 6) - required now. Clerk's SDK reads
# these four itself; they must agree with the routes under `src/app`. Both
# fallbacks point at /onboarding, which is what routes a person to their agency,
# to the picker, to the portal, or to the create an agency form.
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/onboarding"
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/onboarding"

# Optional, and only the Playwright suite reads them: a dedicated user in your
# Clerk *development* instance, used with Clerk testing tokens so the browser
# suite has a way past the sign in screen. Leave both unset to skip those tests.
# E2E_CLERK_USER_USERNAME=""
# E2E_CLERK_USER_PASSWORD=""

# Data model & migrations (feature 3), development only. `pnpm db:seed` writes
# only to localhost unless the DIRECT_URL host is named here. Set it to your
# Supabase dev project's host to seed that; leave it unset everywhere else.
# SEED_ALLOW_HOST=""

# ---------------------------------------------------------------------------
# Later features - fill these in when their feature is built
# ---------------------------------------------------------------------------

# Clerk webhook sync (feature 17). The two Clerk keys themselves moved up to
# the required block: feature 4 needs them to read session claims.
# CLERK_WEBHOOK_SIGNING_SECRET=""

# Subscription checkout & Stripe webhook (feature 8)
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
# STRIPE_SECRET_KEY=""
# STRIPE_WEBHOOK_SECRET=""
# STRIPE_PRICE_ID=""

# Deliverable upload & download, Cloudflare R2 (feature 12)
# R2_ACCOUNT_ID=""
# R2_ACCESS_KEY_ID=""
# R2_SECRET_ACCESS_KEY=""
# R2_BUCKET=""

# Client contacts & portal invitations (feature 10)
# RESEND_API_KEY=""
# EMAIL_FROM=""
# INVITE_TOKEN_SECRET=""

# Rate limiting, Upstash (feature 19)
# UPSTASH_REDIS_REST_URL=""
# UPSTASH_REDIS_REST_TOKEN=""

# Product analytics & error tracking, Sentry (feature 20)
# NEXT_PUBLIC_SENTRY_DSN=""
# SENTRY_AUTH_TOKEN=""
# SENTRY_ORG=""
# SENTRY_PROJECT=""

# Daily cron sweeps (feature 18)
# CRON_SECRET=""
