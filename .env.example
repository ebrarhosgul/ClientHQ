# Copy this file to .env.local and fill in real values.
# .env.local is git ignored; this template is committed and must stay valueless.
#
# Only the "Scaffold" block below is read today. Everything under it is the full
# configuration spec 0001 calls for, kept here so nothing is lost, and switched on
# by the feature that needs it (see docs/scope/scope.md).

# ---------------------------------------------------------------------------
# Scaffold (feature 1) - required now
# ---------------------------------------------------------------------------

# Supabase transaction mode pooler, port 6543. The app runs every query through
# this. Drizzle must run with prepared statements disabled against PgBouncer.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres"

# Direct connection, port 5432. Migrations only, never the running app.
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# Absolute base URL. Used by Stripe redirects and email links later.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Data model & migrations (feature 3), development only. `pnpm db:seed` writes
# only to localhost unless the DIRECT_URL host is named here. Set it to your
# Supabase dev project's host to seed that; leave it unset everywhere else.
# SEED_ALLOW_HOST=""

# ---------------------------------------------------------------------------
# Later features - fill these in when their feature is built
# ---------------------------------------------------------------------------

# Agency sign in & organization, Clerk webhook sync (features 6, 17)
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
# CLERK_SECRET_KEY=""
# CLERK_WEBHOOK_SIGNING_SECRET=""

# Subscription checkout & Stripe webhook (feature 8)
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
# STRIPE_SECRET_KEY=""
# STRIPE_WEBHOOK_SECRET=""
# STRIPE_PRICE_ID=""

# Deliverable upload & download, Cloudflare R2 (feature 12)
# R2_ACCOUNT_ID=""
# R2_ACCESS_KEY_ID=""
# R2_SECRET_ACCESS_KEY=""
# R2_BUCKET=""

# Client contacts & portal invitations (feature 10)
# RESEND_API_KEY=""
# EMAIL_FROM=""
# INVITE_TOKEN_SECRET=""

# Rate limiting, Upstash (feature 19)
# UPSTASH_REDIS_REST_URL=""
# UPSTASH_REDIS_REST_TOKEN=""

# Product analytics & error tracking, Sentry (feature 20)
# NEXT_PUBLIC_SENTRY_DSN=""
# SENTRY_AUTH_TOKEN=""
# SENTRY_ORG=""
# SENTRY_PROJECT=""

# Daily cron sweeps (feature 18)
# CRON_SECRET=""
